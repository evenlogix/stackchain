{
  "name": "@evenlogix/stackchain-cli",
  "version": "0.1.0",
  "description": "StackChain CLI — generate production-ready software foundations",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stackchain": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evenlogix/stackchain.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/evenlogix/stackchain#readme",
  "bugs": {
    "url": "https://github.com/evenlogix/stackchain/issues"
  },
  "keywords": [
    "stackchain",
    "cli",
    "flutter",
    "scaffolding",
    "generator",
    "architecture",
    "dx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/chmod-bin.mjs packages/cli/dist/bin.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@evenlogix/stackchain-engine": "workspace:*",
    "@evenlogix/stackchain-registry": "workspace:*",
    "@evenlogix/stackchain-sdk": "workspace:*",
    "@evenlogix/stackchain-shared": "workspace:*",
    "@evenlogix/stackchain-templates": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
