{
  "name": "@stackchain/templates",
  "version": "0.1.0",
  "description": "Composable StackChain project templates",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./flutter/*": "./flutter/*"
  },
  "files": [
    "dist",
    "flutter",
    "react",
    "backend",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@stackchain/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evenlogix/stackchain.git",
    "directory": "packages/templates"
  },
  "homepage": "https://github.com/evenlogix/stackchain#readme",
  "bugs": {
    "url": "https://github.com/evenlogix/stackchain/issues"
  },
  "keywords": [
    "stackchain",
    "generator",
    "scaffolding",
    "cli"
  ]
}
