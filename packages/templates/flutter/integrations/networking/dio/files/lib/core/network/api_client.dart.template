import 'package:dio/dio.dart';
import 'package:{{project_name}}/core/config/app_config.dart';

class ApiClient {
  ApiClient({Dio? dio})
      : _dio = dio ??
            Dio(
              BaseOptions(
                connectTimeout: const Duration(seconds: 30),
                receiveTimeout: const Duration(seconds: 30),
                headers: {'X-App': AppConfig.appName},
              ),
            );

  final Dio _dio;

  Dio get dio => _dio;
}
