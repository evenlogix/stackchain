import { serve } from '@hono/node-server';
import { Hono } from 'hono';
import { env } from './core/config/env.js';

const app = new Hono();

app.get('/health', (c) => c.json({ status: 'ok', service: env.appName }));
app.get('/', (c) => c.json({ message: 'Welcome to {{project_pascal}}' }));

serve({ fetch: app.fetch, port: env.port }, (info) => {
  console.log(`{{project_pascal}} listening on http://localhost:${info.port}`);
});
